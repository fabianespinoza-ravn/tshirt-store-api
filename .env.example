# Copia este fichero a .env y rellena los valores.
# .env NO se commitea. Nunca pegues estos valores en un prompt.

NODE_ENV=development
# 3000 lo ocupa un Grafana que arranca solo con Docker Desktop.
PORT=3010

# Coincide con docker-compose.yml. Los puertos del host van desplazados porque
# 5432 y 6379 ya están ocupados en esta máquina por contenedores de otro
# proyecto; dentro de los contenedores siguen siendo los de siempre.
DATABASE_URL="postgresql://tshirt:tshirt@localhost:5433/tshirt_store?schema=public"

# Redis para BullMQ
REDIS_HOST=localhost
REDIS_PORT=6380

# Auth. El access token es corto y el refresh viaja en cookie httpOnly.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# Stripe. El webhook secret sale de `stripe listen` en local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# S3 para las imágenes de producto. En local es el MinIO de docker-compose, que
# habla el mismo protocolo; en producción se borra AWS_S3_ENDPOINT y el SDK
# resuelve el host real de AWS. forcePathStyle va ligado al endpoint.
AWS_REGION=us-east-1
AWS_S3_BUCKET=tshirt-store-images
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=tshirt
AWS_SECRET_ACCESS_KEY=tshirt-local-dev

# Correo saliente: verificación, reset y la notificación de reposición de F8
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
