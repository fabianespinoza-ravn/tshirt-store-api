@startuml
!theme plain
title Catálogo 2 de 3 · Gestión: producto, imágenes y variantes
autonumber
skinparam responseMessageBelowArrow true

actor "Manager" as MG
participant "Frontend" as F
participant "API NestJS" as A
database "PostgreSQL" as DB
participant "S3" as S3

note over A : Todas estas rutas pasan por el mismo tamiz:\nJwtAuthGuard, después CASL, después ValidationPipe.\nUn cliente autenticado recibe 403, no 401

== Categorías ==
MG -> F : Crea una categoría
F -> A : POST /categories
alt Nombre duplicado
  A --> F : 409 Conflict
else Correcto
  A -> DB : Inserta
  A --> F : 201
end
F -> A : PATCH /categories/ID
F -> A : DELETE /categories/ID
alt Todavía tiene productos
  A --> F : 409 Conflict
else
  A --> F : 204
end

== Producto ==
MG -> F : Crea un producto
F -> A : POST /products
A -> DB : Inserta el producto
A --> F : 201 con Location

== Imágenes ==
MG -> F : Sube una foto
F -> A : POST /products/ID/images\nmultipart/form-data
activate A
alt Tipo no admitido
  A --> F : 415 UnsupportedMediaType
  note right of A : Solo jpeg, png y webp
else Pasa de 5 MB
  A --> F : 413 PayloadTooLarge
  note right of A : El techo se declara en el contrato\npara que el front rechace el archivo\nantes de subirlo
else Correcto
  A -> S3 : Guarda el binario
  A -> DB : Guarda la fila con su UUIDv7
  A --> F : 201 ProductImage
  note right of DB : La primera imagen por orden de UUIDv7\nes la portada del catálogo
end
deactivate A

F -> A : DELETE /products/ID/images/IMG
alt Un SKU todavía la referencia
  A --> F : 409 Conflict
else Es la última de un producto activo
  A --> F : 409 Conflict
  note right of A : Un producto activo no puede quedarse sin imagen.\nSube el reemplazo antes, o deshabilita el producto
else Correcto
  A -> DB : Borra la fila
  A --> F : 204
end

== Variantes ==
MG -> F : Añade una talla
F -> A : POST /products/ID/skus
alt Combinación de atributos repetida
  A --> F : 409 Conflict
else Correcto
  A -> DB : Inserta el SKU con su stock
  A --> F : 201
end
F -> A : PATCH /skus/ID
note right of A : Cambiar el precio de un SKU desactiva\nsu enlace de pago activo: un enlace\nno puede vender a un precio viejo

== Baja ==
F -> A : DELETE /products/ID
A -> DB : Baja lógica
A --> F : 204
note right of DB : Lógica, no física: los pedidos históricos\nsiguen apuntando al producto

@enduml
