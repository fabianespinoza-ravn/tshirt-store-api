@startuml
!theme plain
title Auth 1 of 3 · Sign-up and email verification
autonumber
skinparam responseMessageBelowArrow true

actor  "Visitor"    as U
participant "Frontend" as F
participant "NestJS API" as A
database "PostgreSQL" as DB
queue "Redis / BullMQ" as Q
participant "Worker" as W
participant "SMTP" as M

U -> F : Fills in the sign-up form
F -> A : POST /auth/sign-up
activate A

alt Invalid body
  A --> F : 400 BadRequest
  note right of A : The whitelist ValidationPipe rejects it\nbefore the service ever sees it
else Per-address limit exceeded
  A --> F : 429 TooManyRequests
  note right of A : The limit is per email address:\nthis route sends mail to an address\nchosen by the caller
else Accepted
  A -> DB : Looks up the account by email
  alt The address has no account
    A -> DB : Creates an unverified user\nand a one-time credential
    A -> Q : Queues the verification link
  else Has an unverified account
    A -> DB : Replaces the pending credential\nand the password
    A -> Q : Queues the verification link
    note right of DB : This is how someone who never confirmed\nand also forgot their password gets back in
  else Has an already verified account
    A -> Q : Queues a sign-in reminder
    note right of A : Nothing is created. The response is identical\nin all three cases: this route never reveals\nwhich addresses are registered
  end
  A --> F : 201 VerificationPending
  deactivate A
  F -> U : We've sent you an email
end

Q -> W : Delivers the job
W -> M : Sends the email

... the visitor opens their inbox ...

U -> F : Clicks the link in the email
F -> A : POST /auth/email-verifications/confirm
note right of F : The token travels in the body, not the URL:\nURLs end up in logs and in the Referer header
activate A
alt Valid token
  A -> DB : Verifies the email and consumes the token
  A --> F : 204
  F -> U : Account activated
else Token missing, expired or already used
  A --> F : 404 EmailVerificationTokenNotFound
  F -> U : Offers to resend the link
end
deactivate A

group Resending the link
  U -> F : Asks for another link
  F -> A : POST /auth/email-verifications
  A -> DB : Invalidates previous links
  A -> Q : Queues the new one, if the account is eligible
  A --> F : 202
  note right of A : 202 whether or not the account exists,\nfor the same reason as sign-up
end

@enduml
