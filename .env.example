# Copy this file to .env and fill in the values.
# .env is NOT committed. Never paste these values into a prompt.

NODE_ENV=development
# 3000 is taken by a Grafana that starts on its own with Docker Desktop.
PORT=3010

# Matches docker-compose.yml. The host ports are shifted because 5432 and
# 6379 are already taken on this machine by another project's containers;
# inside the containers they're still the usual ones.
DATABASE_URL="postgresql://tshirt:tshirt@localhost:5433/tshirt_store?schema=public"

# Redis for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6380

# Auth. The access token is short-lived and the refresh token travels in an
# httpOnly cookie.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# Stripe. The webhook secret comes from `stripe listen` locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# S3 for product images. Locally it's the MinIO from docker-compose, which
# speaks the same protocol; in production AWS_S3_ENDPOINT is removed and the
# SDK resolves the real AWS host. forcePathStyle is tied to the endpoint.
AWS_REGION=us-east-1
AWS_S3_BUCKET=tshirt-store-images
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=tshirt
AWS_SECRET_ACCESS_KEY=tshirt-local-dev

# Outgoing mail: verification, reset and F8's restock notification
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
