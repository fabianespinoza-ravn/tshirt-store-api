@startuml
!theme plain
title Catalog 2 of 3 · Management: product, images and variants
autonumber
skinparam responseMessageBelowArrow true

actor "Manager" as MG
participant "Frontend" as F
participant "NestJS API" as A
database "PostgreSQL" as DB
participant "S3" as S3

note over A : All these routes go through the same sieve:\nJwtAuthGuard, then CASL, then ValidationPipe.\nAn authenticated customer gets 403, not 401

== Categories ==
MG -> F : Creates a category
F -> A : POST /categories
alt Duplicate name
  A --> F : 409 Conflict
else Success
  A -> DB : Inserts
  A --> F : 201
end
F -> A : PATCH /categories/ID
F -> A : DELETE /categories/ID
alt Still has products
  A --> F : 409 Conflict
else
  A --> F : 204
end

== Product ==
MG -> F : Creates a product
F -> A : POST /products
A -> DB : Inserts the product
A --> F : 201 with Location

== Images ==
MG -> F : Uploads a photo
F -> A : POST /products/ID/images\nmultipart/form-data
activate A
alt Unsupported type
  A --> F : 415 UnsupportedMediaType
  note right of A : Only jpeg, png and webp
else Exceeds 5 MB
  A --> F : 413 PayloadTooLarge
  note right of A : The ceiling is declared in the contract\nso the front can reject the file\nbefore uploading it
else Success
  A -> S3 : Stores the binary
  A -> DB : Stores the row with its UUIDv7
  A --> F : 201 ProductImage
  note right of DB : The first image by UUIDv7 order\nis the catalog cover
end
deactivate A

F -> A : DELETE /products/ID/images/IMG
alt A SKU still references it
  A --> F : 409 Conflict
else It's the last image of an active product
  A --> F : 409 Conflict
  note right of A : An active product can't be left without an image.\nUpload the replacement first, or disable the product
else Success
  A -> DB : Deletes the row
  A --> F : 204
end

== Variants ==
MG -> F : Adds a size
F -> A : POST /products/ID/skus
alt Duplicate attribute combination
  A --> F : 409 Conflict
else Success
  A -> DB : Inserts the SKU with its stock
  A --> F : 201
end
F -> A : PATCH /skus/ID
note right of A : Changing a SKU's price deactivates\nits active payment link: a link\ncan't sell at a stale price

== Deactivation ==
F -> A : DELETE /products/ID
A -> DB : Soft delete
A --> F : 204
note right of DB : Soft, not hard: historical orders\nstill point at the product

@enduml
