node_modules/
dist/
# `npm run build:deploy` output: the pre-deploy scripts compiled for the
# production image, which builds them itself.
dist-deploy/
coverage/

# Never commit secrets. .env.example is the template.
.env
.env.*
!.env.example

*.log
.DS_Store

# No migration history is versioned. The database is synced straight from
# schema.prisma with `prisma db push`; a migration generated locally for
# exploration (`prisma migrate dev`) stays local.
/prisma/migrations/

# Personal to this machine, never shared.
.claude/settings.local.json

# Planning notes and drafts at the root. The project's documentation
# lives in docs/, which does get versioned.
/*.md
!/README.md
!/CLAUDE.md
