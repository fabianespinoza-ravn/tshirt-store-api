@startuml
!theme plain
title Pedidos · Historial, detalle y ciclo de estados
autonumber
skinparam responseMessageBelowArrow true

actor "Cliente" as U
actor "Manager" as MG
actor "Repartidor" as D
participant "API NestJS" as A
database "PostgreSQL" as DB
participant "Stripe" as S

== Historial: tres lecturas de la misma ruta ==
alt Quien llama es cliente
  U -> A : GET /orders con filtros
  A -> DB : Solo los suyos
  A --> U : PaginatedOrders
else Quien llama es manager
  MG -> A : GET /orders?customerId=...
  A --> MG : PaginatedManagerOrders, con el comprador en cada fila
else Quien llama es repartidor
  D -> A : GET /orders?status=SHIPPED
  A --> D : Su cola de reparto
  D -> A : GET /orders?status=DELIVERED
  A --> D : Solo lo que entregó él
end
note right of A : Sin parámetro status el listado omite los FAILED,\ny una lista explícita se respeta tal cual.\nOrden por createdAt desc y luego por id,\npara que la paginación sea estable

== Detalle ==
U -> A : GET /orders/ID
activate A
alt Fuera del alcance de quien llama
  A --> U : 404 NotFound
  note right of A #ffe0e0 : 404 y **nunca** 403: un 403 confirmaría que ese id\nexiste, y el código serviría para enumerar\npedidos ajenos
else Dentro del alcance
  alt Manager
    A --> MG : 200 ManagerOrderDetail
  else El comprador
    A --> U : 200 OrderDetail
  end
end
deactivate A

== Avanzar o cancelar ==
U -> A : PATCH /orders/ID/status
activate A
alt Manager
  alt De PAID a PROCESSING, o de PROCESSING a SHIPPED
    A -> DB : Avanza
    A --> MG : 200 ManagerOrderDetail
  else Salto de estado
    A --> MG : 409 Conflict
  end
else Cliente, y solo CANCELLED sobre un pedido propio
  alt Todavía no ha salido
    alt Estaba pagado
      A -> S : refund
      A -> DB : Devuelve las unidades y baja el uso del cupón
      note right of DB : El pago se queda registrado como succeeded.\nCancelar no borra que se cobró
    else No estaba pagado
      A -> DB : Libera las dos retenciones, sin reembolso
    end
    A --> U : 200 OrderDetail
  else Ya se envió
    A --> U : 409 Conflict
  end
else Repartidor
  alt De SHIPPED a DELIVERED
    A -> DB : Registra la entrega
    A --> D : 200
    note right of A : En su siguiente GET recibirá 404:\nel pedido ha salido de su alcance
  else Otro repartidor ya lo registró
    A --> D : 409 Conflict
  end
else El rol no puede pedir ese estado
  A --> U : 403 Forbidden
  note right of A : El enum no puede expresar qué valores puede pedir\ncada rol: rol equivocado es 403,\ntransicion equivocada es 409
end
deactivate A

@enduml
