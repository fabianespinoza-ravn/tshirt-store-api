@startuml
!theme plain
title Auth 3 of 3 · Passwords: forgot, reset and change
autonumber
skinparam responseMessageBelowArrow true

actor "User" as U
participant "Frontend" as F
participant "NestJS API" as A
database "PostgreSQL" as DB
queue "Redis / BullMQ" as Q
participant "Worker" as W
participant "SMTP" as M

== I forgot my password ==
U -> F : Enters their email
F -> A : POST /auth/forgot-password
activate A
alt Malformed email
  A --> F : 400 BadRequest
else Per-address limit exceeded
  A --> F : 429 TooManyRequests
else Accepted
  A -> DB : Looks up the account
  alt The account is eligible
    A -> Q : Queues the reset email
  else Doesn't exist or isn't eligible
    note right of A : Nothing is queued
  end
  A --> F : 202
  note right of A : 202 in both cases.\nA 404 here would turn the route\ninto a registered-email finder
end
deactivate A
Q -> W : Delivers the job
W -> M : Sends the link

... the user opens the email ...

== Reset with the token ==
U -> F : Opens the link and enters the new password
F -> A : POST /auth/reset-password\ntoken + newPassword
activate A
alt Valid token and password of 12 or more
  A -> DB : Changes the password
  A -> DB : Revokes **all** refresh families
  note right of DB : Sessions opened before the change\nstop working. That's the point:\nif the account was hijacked, access is cut off
  A --> F : 204
  F -> U : Can now sign in
else Password too short or invalid body
  A --> F : 400 BadRequest
else Token missing, expired or already used
  A --> F : 404 NotFound
else Too many attempts
  A --> F : 429 TooManyRequests
end
deactivate A

== Change it while signed in ==
U -> F : Current and new password
F -> A : PATCH /auth/password\nAuthorization: Bearer
activate A
alt No token or invalid token
  A --> F : 401 Unauthorized
else Current doesn't match or new one is too short
  A --> F : 400 BadRequest
else Success
  A -> DB : Changes the password and revokes the families
  A -> Q : Queues the mandatory email notice
  A --> F : 204
end
deactivate A
Q -> W : Delivers the job
W -> M : Notifies that the password changed
note over M : The notice isn't a courtesy: it's how the owner\nof a compromised account finds out

@enduml
